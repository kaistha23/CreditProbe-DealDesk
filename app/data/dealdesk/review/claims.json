{
 "description": "R11 R1: assertion patterns for the claims ledger. Each pattern (a case-insensitive regex) turns a memo line into an assertion claim; rules in rules.json refer to the id. A named group (?P<v>...) captures the asserted value. The bank adds patterns here.",
 "version": "r11-1",
 "assertions": [
  {"id": "recommendation", "label": "Recommendation", "pattern": "recommendation:\\s*(?P<v>[^.]+)", "claims": "The relationship recommendation"},
  {"id": "recommend_as_requested", "label": "Recommendation", "pattern": "(?P<v>recommends the facility as requested)", "claims": "Approve the facility as requested"},
  {"id": "approve_all", "label": "Approve all", "pattern": "\\bapprove all\\b", "claims": "Approve all requested limits"},
  {"id": "cro_review", "label": "CRO review", "pattern": "^CRO review:\\s*(?P<v>.*)$", "claims": "CRO review box"},
  {"id": "retentions_not_due", "label": "Retentions not due", "pattern": "retentions?.{0,80}not due", "claims": "Retentions on completed projects are not yet due"},
  {"id": "stressed_deficit", "label": "Stressed cash flow", "pattern": "stressed cash flow:?\\s*peak deficit", "claims": "Stressed deficit and the funded lines that cover it"},
  {"id": "no_cash_margin", "label": "No cash margin", "pattern": "no cash margin", "claims": "Guarantees issued without a cash margin"},
  {"id": "open_ended_lg", "label": "Open-ended guarantees", "pattern": "open-ended guarantees", "claims": "Guarantees open-ended in the beneficiary's format"},
  {"id": "deferred_perfection", "label": "Deferred perfection", "pattern": "deferred perfection", "claims": "Corporate guarantee perfected after drawdown"},
  {"id": "legal_opinion", "label": "Legal opinion", "pattern": "legal opinion", "claims": "Legal opinion on the security"},
  {"id": "late_bond", "label": "Performance bond", "pattern": "performance bond submitted", "claims": "Performance bond submission"},
  {"id": "ownership_change", "label": "Ownership change", "pattern": "ownership .{0,30}changed", "claims": "Ownership of the group changed"},
  {"id": "auditor_changed", "label": "Auditor change", "pattern": "auditor was changed", "claims": "The auditor was changed"},
  {"id": "auditor_unlisted", "label": "Auditor", "pattern": "not on the (?:bank's )?approved list", "claims": "Auditor not on the approved list"},
  {"id": "no_standalone_fs", "label": "Standalone financials", "pattern": "no standalone financials", "claims": "No standalone financials of the borrowing entity"},
  {"id": "returned_cheques", "label": "Returned cheques", "pattern": "returned cheques", "claims": "Returned cheques at the bureau"},
  {"id": "other_bank_facilities", "label": "New facilities at other banks", "pattern": "facilities at \\d+ other banks", "claims": "New facilities at other banks"},
  {"id": "backlog", "label": "Backlog", "pattern": "^Backlog \\|", "claims": "Order backlog and its growth"},
  {"id": "backlog_concentration", "label": "Backlog concentration", "pattern": "^Backlog concentration", "claims": "Backlog by developer"},
  {"id": "working_capital", "label": "Working capital", "pattern": "^Working capital \\|", "claims": "Working capital against the prior year"},
  {"id": "noncore_property", "label": "Non-core property", "pattern": "investment property \\(non-core\\)", "claims": "Non-core property investment"},
  {"id": "parent_rp_dues", "label": "Parent related-party dues", "pattern": "parent related-party dues", "claims": "Parent's related-party dues"},
  {"id": "project_status", "label": "Project status", "pattern": "^(?P<v>Project \\d+):", "claims": "Project progress and collections"},
  {"id": "group_cap", "label": "Group exposure cap", "pattern": "group exposure cap", "claims": "Group exposure cap and exposure after the request"},
  {"id": "vehicle_registration", "label": "Vehicle registration", "pattern": "vehicles will be registered to", "claims": "Registration of the financed vehicles"},
  {"id": "connected_classified", "label": "Connected obligor", "pattern": "classified (?:doubtful|substandard|loss)", "claims": "A connected name classified at another bank"},
  {"id": "nominee_holding", "label": "Nominee holding", "pattern": "through nominees", "claims": "Holding through nominees"},
  {"id": "group_loss", "label": "Group entities at Loss", "pattern": "group entities at loss", "claims": "Group entities classified Loss"},
  {"id": "routing", "label": "Routing undertaking", "pattern": "routing undertaking", "claims": "Routing undertaking and its fulfilment"},
  {"id": "routing_lowered", "label": "Routing lowered", "pattern": "lower the routing undertaking|lowers the undertaking", "claims": "Routing undertaking lowered"},
  {"id": "staff_guarantor", "label": "Staff-owned guarantor", "pattern": "owned by a bank staff member", "claims": "Guarantor owned by bank staff"},
  {"id": "related_party_receivable", "label": "Due from related parties", "pattern": "^Due from related parties", "claims": "Receivable from related parties"},
  {"id": "goodwill", "label": "Internally generated goodwill", "pattern": "internally generated goodwill", "claims": "Goodwill and the audit opinion"},
  {"id": "aged_receivables", "label": "Receivables over 1 year", "pattern": "^Receivables over 1 year", "claims": "Receivables older than a year"},
  {"id": "cash_cycle", "label": "Cash conversion cycle", "pattern": "^Cash conversion cycle", "claims": "Cash conversion cycle"},
  {"id": "shareholder_withdrawals", "label": "Shareholder withdrawals", "pattern": "^Shareholder withdrawals", "claims": "Shareholder withdrawals"},
  {"id": "simah", "label": "SIMAH", "pattern": "^SIMAH \\| (?P<v>\\w+)", "claims": "Bureau status"},
  {"id": "existing_exposure", "label": "Existing exposure", "pattern": "^Existing exposure", "claims": "Existing exposure with the bank"},
  {"id": "internal_rating", "label": "Internal rating", "pattern": "^Internal rating \\| (?P<v>\\S+)", "claims": "Internal rating"}
 ]
}
