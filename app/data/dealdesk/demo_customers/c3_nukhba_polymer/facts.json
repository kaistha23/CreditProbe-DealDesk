  "FY2024": [
   [
    "Note 16 — Borrowings",
    "Term loan from Coastal Gulf Bank SAR 96,000,000 (2023: 120,000,000), repayable in 15 quarterly instalments of SAR 8,000,000 from 30/06/2024 to 31/12/2027, secured by a first-ranking charge over the machinery; financial covenant DSCR not below 1.25x."
   ]
  ],
  "FY2025": [
   [
    "Note 16 — Borrowings",
    "Term loan from Coastal Gulf Bank SAR 72,000,000, of which SAR 40,000,000 current at 31/12/2025; the instalment of SAR 8,000,000 due 31/12/2025 was unpaid at the year end. The DSCR covenant (1.25x) was not met at 31/12/2025; the lender has not demanded repayment. Short-term Murabaha and LC acceptances SAR 62,300,000."
   ],
   [
    "Note 9 — Revenue",
    "Export sales to GCC customers 24% (2024: 26%). Prices of PET resin rose 18% in 2025; selling prices lagged."
   ],
   [
    "Note 24 — Subsequent events",
    "On 18/03/2026 the Company and Coastal Gulf Bank agreed to reschedule the term loan: the four instalments due 31/12/2025 to 30/09/2026 (SAR 32,000,000) were deferred; the balance of SAR 72,000,000 is repayable in 8 quarterly instalments of SAR 9,000,000 from 31/12/2026, final maturity extended from 31/12/2027 to 30/09/2028."
   ]
  ]
