# CreditProbe Deal Desk edition: the model gateway (ops/v5.sh reads these from the environment; copy to
# var/runpod.env and `set -a; . var/runpod.env; set +a` before ops/runpod/start_dealdesk.sh). Never commit a key.

# --- which model Deal Desk talks to ---------------------------------------------------------------------------
# anthropic | openai | auto (auto = openai when CONVO_OPENAI_BASE_URL is set, else anthropic when a key is present)
CONVO_PROVIDER=openai

# the OpenAI-compatible server (vLLM on the pod; llama.cpp or MLX on the Mac)
CONVO_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
CONVO_OPENAI_API_KEY=none
CONVO_OPENAI_MODEL=Qwen/Qwen3.8-27B
CONVO_OPENAI_QUANT=bf16                      # a label for the telemetry only: bf16 | fp8 | gptq-int4 | q8_0 | q4_k_m
CONVO_OPENAI_TOOL_CHOICE=required            # required (every step is a tool call, as with Opus) | auto
CONVO_OPENAI_THINKING=off                    # off | on (Qwen3 thinking; slower, more reasoning tokens)
CONVO_OPENAI_TIMEOUT_S=600
CONVO_OPENAI_STREAM=off                      # on records time to first token too
# Qwen's recommended non-thinking sampling, if you want it instead of temperature 0 (the default here):
# CONVO_OPENAI_EXTRA_BODY={"temperature": 0.7, "top_p": 0.8, "top_k": 20, "presence_penalty": 1.5}
CONVO_MAX_TOKENS=4000

# the Opus baseline (CONVO_PROVIDER=anthropic): the key goes in the environment only, never in a file you commit
# CONVO_ANTHROPIC_API_KEY=sk-ant-...
# CONVO_MODEL=claude-opus-5

# --- the experiment label every telemetry row and ops/model_lab.py run carries ---------------------------------
CONVO_EXPERIMENT=qwen38-27b-bf16

# --- the edition and the demo store ----------------------------------------------------------------------------
V5_EDITION=dealdesk
V5_UI_PORT=6600
CP_DEMO_PASSWORD_IS_USERNAME=1               # a fresh store seeds password = username (the Mac demo convention)
